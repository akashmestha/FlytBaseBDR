# Copy to .env (for local dev) and/or set as a build-time environment
# variable on your hosting platform (Vercel/Netlify/etc) for production.
# Vite only reads env vars prefixed with VITE_.

# Point this at your deployed backend, e.g.:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=http://127.0.0.1:8000
