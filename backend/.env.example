# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it's in .gitignore).

# Used by app/services/llm.py
GEMINI_API_KEY=

# Used by app/services/search.py
TAVILY_API_KEY=

# Not currently used by any code path (kept for reference / future use)
GROQ_API_KEY=

# Comma-separated list of frontend origins allowed to call this API.
# Example for local dev + a deployed frontend:
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
